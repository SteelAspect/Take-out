{
  "schemaVersion": 1,
  "id": "containerautofill_server",
  "version": "${version}",
  "name": "Container Auto Fill (Server)",
  "description": "Server side of Container Auto Fill: lets players pull items out of shulker boxes in their inventory. Install on Fabric dedicated servers only.",
  "authors": ["steelaspect"],
  "contact": {
    "sources": "https://github.com/SteelAspect/Take-out",
    "issues": "https://github.com/SteelAspect/Take-out/issues"
  },
  "license": "LGPL-3.0-only",
  "environment": "server",
  "entrypoints": {
    "server": ["dev.steelaspect.containerautofill.server.ContainerAutoFillServer"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "fabric-api": "*"
  },
  "breaks": {
    "takeitout": "*"
  }
}
